{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/office-hook.py 0<&0 >/dev/null 2>&1 &'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/office-hook.py 0<&0 >/dev/null 2>&1 &'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/office-hook.py 0<&0 >/dev/null 2>&1 &'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 ~/.claude/office-hook.py 0<&0 >/dev/null 2>&1 &'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
